{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|Android|Mobile|BlackBerry|Opera Mini|IEMobile).* "
        }
      ],
      "destination": "/mobile.html",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/desktop.html",
      "permanent": false
    }
  ]
}
